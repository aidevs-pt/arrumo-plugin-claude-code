{
  "schemaVersion": 7,
  "id": "claude-code",
  "name": "Claude Code",
  "description": "Uses your Claude plan. Image generation needs an OpenAI or Gemini key, added next.",
  "capabilities": {
    "agents": {
      "name": "Agent adapter",
      "description": "Plan and execute editing jobs and report progress."
    },
    "subtitle-translation": {
      "name": "Subtitle translation",
      "description": "Translate timed subtitle cues to a selected language."
    }
  },
  "agentProvider": {
    "label": "Claude Code",
    "setupUrl": "https://code.claude.com/docs/en/setup",
    "cli": {
      "executable": "claude",
      "authStatusArgs": [
        "auth",
        "status"
      ],
      "structuredRun": {
        "args": [
          "--print",
          "--restricted",
          "--no-session-persistence",
          "--tools",
          "",
          "--strict-mcp-config",
          "--mcp-config",
          "{\"mcpServers\":{}}",
          "--settings",
          "{\"disableAllHooks\":true}",
          "--output-format",
          "json",
          "--json-schema",
          "{schema}"
        ],
        "result": {
          "source": "stdout",
          "pointer": "/structured_output",
          "errorPointer": "/is_error"
        }
      }
    }
  }
}
